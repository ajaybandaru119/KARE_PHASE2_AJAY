SINGLE LINKED LIST :

Sum of the elements:

class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    public static void main(String[] args) {

        Node head = new Node(10);
        Node second = new Node(20);
        Node third = new Node(30);
        Node fourth = new Node(40);

        head.next = second;
        second.next = third;
        third.next = fourth;
        fourth.next = head;  

        int sum = 0;
        Node current = head;

        do {
            sum += current.data;
            current = current.next;
        } while (current != head);

        System.out.println("Sum = " + sum);
    }
}


SORT ELEMENTS:

class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    public static void main(String[] args) {

        Node head = new Node(30);
        Node second = new Node(10);
        Node third = new Node(40);
        Node fourth = new Node(20);

        head.next = second;
        second.next = third;
        third.next = fourth;
        fourth.next = head;

        Node current = head;

        do {
            Node index = current.next;

            while (index != head) {
                if (current.data > index.data) {
                    int temp = current.data;
                    current.data = index.data;
                    index.data = temp;
                }
                index = index.next;
            }

            current = current.next;

        } while (current != head);

        current = head;

        do {
            System.out.print(current.data + " ");
            current = current.next;
        } while (current != head);
    }
}


