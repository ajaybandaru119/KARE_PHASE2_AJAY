REVERSE ELEMENT

class Node {
    int data;
    Node next;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    public static void main(String[] args) {

        Node head = new Node(10);
        Node second = new Node(20);
        Node third = new Node(30);
        Node fourth = new Node(40);

        head.next = second;
        second.next = third;
        third.next = fourth;
        fourth.next = head;

        Node left = head;
        Node right = head;

        while (right.next != head) {
            right = right.next;
        }

        while (left != right && left.next != right) {
            int temp = left.data;
            left.data = right.data;
            right.data = temp;

            left = left.next;

            Node current = head;
            while (current.next != right) {
                current = current.next;
            }
            right = current;
        }

        Node current = head;
        do {
            System.out.print(current.data + " ");
            current = current.next;
        } while (current != head);
    }
}

