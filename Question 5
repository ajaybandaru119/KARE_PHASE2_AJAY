class Node {
    int data;
    Node prev, next;

    Node(int data) {
        this.data = data;
    }
}

class Main {
    public static void main(String[] args) {
        Node a = new Node(10);
        Node b = new Node(30);

        a.next = b;
        b.prev = a;

        Node x = new Node(20);

        x.prev = a;
        x.next = b;
        a.next = x;
        b.prev = x;

        Node temp = a;
        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }
}
